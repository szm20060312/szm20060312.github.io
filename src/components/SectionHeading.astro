---
interface Props { title: string; number?: string; link?: string; linkText?: string }
const { title, number, link, linkText } = Astro.props;
---
<div class="section-heading">
  <h2>{number && <span class="section-number" aria-hidden="true">{number}</span>}{title}</h2>
  {link && <a class="text-link" href={link}>{linkText}<span aria-hidden="true"> ↗</span></a>}
</div>
