---
import { bio, interests } from '../data/profile';
import { pathFor, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const b = bio[locale];
---
<header class="page-intro"><p class="eyebrow">{locale === 'en' ? 'Areas of interest' : '关注方向'}</p><h1>{locale === 'en' ? 'Research interests' : '研究兴趣'}</h1><p>{b.researchIntro}</p></header>
<div class="research-list">{interests[locale].map((interest) => <section class="research-item" id={interest.id}><div class="research-item-heading"><h2>{interest.title}</h2><p class="eyebrow">{interest.short}</p></div><div class="research-item-body"><p>{interest.description}</p>{interest.related.length > 0 && <div class="related-links">{interest.related.map((link) => <a href={pathFor(locale, link.path)}>{link.title} <span aria-hidden="true">↗</span></a>)}</div>}</div></section>)}</div>
