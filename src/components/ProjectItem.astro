---
import type { CollectionEntry } from 'astro:content';
import { pathFor, ui, type Locale } from '../lib/i18n';
interface Props { entry: CollectionEntry<'projects'>; locale: Locale }
const { entry, locale } = Astro.props;
const data = entry.data;
const t = ui[locale];
---
<article class="project-item" aria-labelledby={`project-${data.slug}`}>
  <div class="project-item-heading">
    <h3 id={`project-${data.slug}`}><a href={pathFor(locale, `projects/${data.slug}`)}>{data.title}</a></h3>
    <p class="project-meta"><span>{data.kind}</span><span>{data.role}</span></p>
    <ul class="project-technologies" aria-label={t.technologies}>{data.tags.map((tag) => <li translate="no">{tag}</li>)}</ul>
  </div>
  <div class="project-item-body">
    <p class="project-summary">{data.summary}</p>
    <div class="project-resources">
      <a href={pathFor(locale, `projects/${data.slug}`)}>{t.project} <span aria-hidden="true">↗</span></a>
      {data.links.map((link) => <a href={link.url}>{t[link.kind]} <span aria-hidden="true">↗</span></a>)}
    </div>
  </div>
</article>
